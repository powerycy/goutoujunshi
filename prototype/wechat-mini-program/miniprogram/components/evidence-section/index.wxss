.section { margin-top:34rpx; padding:0 0 30rpx; border-bottom:2rpx solid #eeeeee; }
.section.sage { border-bottom-color:#bde8cd; }
.section.danger { border-bottom-color:#e8c6c3; }
.heading { display:flex; align-items:baseline; gap:16rpx; color:#3f3f3f; font-size:var(--type-title); font-weight:800; }
.heading-index { color:#18a956; font-size:var(--type-caption); font-weight:700; }
.body { margin-top:18rpx; color:#4f4f4f; font-size:var(--type-body); line-height:1.75; white-space:pre-wrap; }
.item { display:flex; gap:14rpx; margin-top:16rpx; color:#4f4f4f; font-size:var(--type-body); line-height:1.68; }
.item-mark { color:#18a956; }
.item-copy { flex:1; }
