<view class="page-shell loading-page">
  <view class="loading-head page-enter">
    <image class="loading-logo" src="/assets/doghead-logo.png" mode="aspectFit" />
    <view class="title">狗头军师正在分析</view>
    <view class="subtitle">正在把事实、推测和下一步整理清楚。</view>
  </view>
  <view class="progress-list">
    <view wx:for="{{steps}}" wx:key="*this" class="step {{index <= step ? 'active' : ''}} {{index < step ? 'done' : ''}}">
      <view class="step-mark">{{index + 1}}</view>
      <view class="step-content"><text class="step-title">{{item}}</text><text class="step-copy">{{index === 0 ? '先降低冲动成本' : index === 1 ? '区分已知、推测与未知' : '生成行动与停止条件'}}</text></view>
    </view>
  </view>
  <view class="privacy-note">分析未成功交付，不扣狗头。你可以先离开，结果会保存在历史判断中。</view>
  <view wx:if="{{message}}" class="danger-note">{{message}}</view>
  <button wx:if="{{message}}" class="secondary-button history-button" bindtap="goHistory">查看历史判断</button>
  <button class="plain" bindtap="goHome">返回首页</button>
</view>
