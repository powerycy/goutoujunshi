<view class="page-shell loading-page">
  <view class="docket page-enter">
    <view class="meta-label">ANALYSIS / {{analysisId}}</view>
    <view class="title">正在生成结构化分析</view>
    <view class="subtitle">系统依次整理信息、形成判断和生成行动方案；失败不会核销免费次数。</view>
  </view>
  <view class="folder">
    <view class="folder-tab">案情处理中</view>
    <view wx:for="{{steps}}" wx:key="*this" class="step {{index <= step ? 'active' : ''}} {{index < step ? 'done' : ''}}">
      <view class="step-mark">{{index < step ? '✓' : index + 1}}</view>
      <view><text>{{item}}</text><text class="step-copy">{{index === 0 ? '先降低冲动成本' : index === 1 ? '区分已知、推测与未知' : '生成行动与停止条件'}}</text></view>
    </view>
  </view>
  <view class="privacy-note">分析只读取根 Skill 与当前场景最相关的 1–3 份知识文件；不会把整套知识库塞进模型，也不会把问题正文放进产品埋点。</view>
  <view wx:if="{{message}}" class="danger-note">{{message}}</view>
  <button wx:if="{{message}}" class="secondary-button" bindtap="goHistory">查看历史分析</button>
  <button class="plain" bindtap="goHome">先回首页，任务继续处理</button>
</view>
