.loading-page {
  padding-top: 54rpx;
  overflow: visible;
}

.loading-head {
  text-align: center;
}

.loading-logo {
  width: 68rpx;
  height: 68rpx;
  margin-bottom: 24rpx;
}

.loading-head .title {
  margin-top: 0;
}

.progress-list {
  margin-top: 54rpx;
  border-top: 2rpx solid #eeeeee;
}

.step {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 112rpx;
  border-bottom: 2rpx solid #eeeeee;
  opacity: .42;
}

.step.active {
  opacity: 1;
}

.step-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #cccccc;
  border-radius: 50%;
  color: #8d8d8d;
  font-size: var(--type-caption);
  font-weight: 700;
  box-sizing: border-box;
}

.step.active .step-mark {
  border-color: #18c463;
  background: #18c463;
  color: #ffffff;
}

.step.done .step-mark {
  border-color: #bde8cd;
  background: #eefaf3;
  color: #18a956;
}

.step-content {
  flex: 1;
}

.step-title,
.step-copy {
  display: block;
}

.step-title {
  color: #444444;
  font-size: var(--type-body);
  font-weight: 700;
}

.step-copy {
  margin-top: 7rpx;
  color: #8a8a8a;
  font-size: var(--type-caption);
}

.privacy-note {
  margin-top: 28rpx;
  color: #8f8f8f;
  font-size: var(--type-caption);
  line-height: 1.65;
  text-align: center;
}

.loading-page .danger-note {
  border: 0;
  border-radius: 16rpx;
  background: #fff5f4;
  color: #9b4742;
  font-size: var(--type-caption);
}

.history-button {
  margin-top: 26rpx;
}

.plain {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  margin-top: 14rpx;
  padding: 0;
  background: transparent;
  color: #777777;
  font-size: var(--type-secondary);
}
