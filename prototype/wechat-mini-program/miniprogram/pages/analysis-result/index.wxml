<view class="page-shell result-page">
  <view wx:if="{{loading}}" class="title">正在读取分析报告…</view>
  <view wx:elif="{{error}}" class="danger-note">{{error}}</view>
  <block wx:elif="{{task.status === 'failed'}}">
    <view class="result-head"><image class="result-logo" src="/assets/doghead-logo.png" mode="aspectFit" /><view class="title">这次没有分析成功</view></view>
    <view class="danger-note">{{task.errorMessage || '暂时没有生成可用分析。'}}本次不扣狗头，可稍后重试。</view>
  </block>
  <block wx:elif="{{task.status === 'blocked'}}">
    <view class="result-head"><image class="result-logo" src="/assets/doghead-logo.png" mode="aspectFit" /><view class="title">先处理现实安全</view><view class="subtitle">这不是普通的关系策略问题。</view></view>
    <view class="danger-note">{{result.emotionalGrounding}}</view>
    <evidence-section index="01" title="现在先做" tone="danger" items="{{result.facts}}" />
    <evidence-section index="02" title="安全行动" tone="sage" text="{{result.nextAction}}" />
    <evidence-section index="03" title="停止条件与求助" tone="danger" items="{{result.stopConditions}}" />
    <view class="ai-label">{{result.safetyNote || aiDisclosure}}</view>
  </block>
  <block wx:elif="{{result}}">
    <view class="result-head page-enter">
      <image class="result-logo" src="/assets/doghead-logo.png" mode="aspectFit" />
      <view class="title">狗头军师的判断</view>
      <view class="subtitle">先看核心判断，再决定下一步。</view>
    </view>
    <evidence-section index="01" title="先稳一下" text="{{result.emotionalGrounding}}" />
    <view class="evidence-grid">
      <evidence-section index="02A" title="已知事实" items="{{result.facts}}" />
      <evidence-section index="02B" title="合理推测" items="{{result.inferences}}" />
      <evidence-section index="02C" title="关键未知" items="{{result.unknowns}}" />
    </view>
    <evidence-section index="03" title="核心判断" tone="sage" text="{{result.recommendation}}" items="{{result.reasons}}" />
    <evidence-section index="04" title="下一步" tone="sage" text="{{result.nextAction}}" />
    <view wx:if="{{result.messageDraft}}" class="message-draft"><view class="label">可选话术</view><view>“{{result.messageDraft}}”</view></view>
    <evidence-section index="05" title="观察窗口" text="{{result.observationWindow}}" />
    <evidence-section index="06" title="停止条件" tone="danger" items="{{result.stopConditions}}" />
    <view class="ai-label">{{result.safetyNote || aiDisclosure}}</view>
  </block>
  <button class="primary-button result-action" bindtap="goHome">再问一个问题</button>
  <button class="secondary-button next" bindtap="goHistory">查看历史判断</button>
</view>
