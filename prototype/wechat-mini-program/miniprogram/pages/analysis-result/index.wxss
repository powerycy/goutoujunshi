.result-page {
  padding-top: 48rpx;
  overflow: visible;
}

.result-head {
  padding-bottom: 18rpx;
  text-align: center;
}

.result-logo {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 22rpx;
}

.result-head .title {
  margin-top: 0;
}

.evidence-grid {
  margin-top: 18rpx;
}

.message-draft {
  margin-top: 34rpx;
  padding: 26rpx;
  border-radius: 16rpx;
  background: #f1faf5;
  color: #444444;
  font-size: var(--type-body);
  line-height: 1.72;
}

.message-draft .label {
  margin-bottom: 12rpx;
  color: #18a956;
  font-size: var(--type-caption);
  font-weight: 700;
}

.ai-label {
  margin: 30rpx 0;
  color: #969696;
  font-size: var(--type-caption);
  line-height: 1.65;
  text-align: center;
}

.result-page .danger-note {
  border: 0;
  border-radius: 16rpx;
  background: #fff5f4;
  color: #9b4742;
  font-size: var(--type-secondary);
}

.result-action {
  margin-top: 36rpx;
}

.next {
  margin-top: 16rpx;
}
