beta-badge { display:block; margin-top:30rpx; }
.no-ticket { margin-top:28rpx; padding:26rpx; border:2rpx solid #d89b47; border-radius:20rpx; background:#fff0c7; }
.no-ticket view { font-size:28rpx; font-weight:800; }
.no-ticket text { display:block; margin-top:8rpx; color:#725d45; font-size:23rpx; line-height:1.55; }
.no-ticket button { margin:18rpx 0 0; background:#251d17; color:#fff8eb; font-size:24rpx; }
.form-sheet { margin-top:30rpx; padding:30rpx 26rpx; border:2rpx solid #eadfd0; border-radius:20rpx; background:#fffcf6; }
.field { margin-top:28rpx; }
.field:first-child { margin-top:0; }
.field-grid { display:flex; gap:18rpx; }
.half { flex:1; min-width:0; }
.field-label { color:#3d3027; font-size:25rpx; font-weight:800; }
.field-label text { margin-right:12rpx; color:#c2602c; font:20rpx ui-monospace,SFMono-Regular,Menlo,monospace; }
.field-label .intensity { float:right; color:#c2602c; }
.case-input { box-sizing:border-box; width:100%; height:330rpx; margin-top:18rpx; padding:24rpx; border:2rpx solid #e2d5c7; border-radius:12rpx; background:#fff; font-size:27rpx; line-height:1.65; }
.privacy-tip { margin-top:12rpx; color:#8b7b70; font-size:21rpx; line-height:1.5; }
input,.picker-value { box-sizing:border-box; height:80rpx; margin-top:12rpx; padding:0 20rpx; border:2rpx solid #e2d5c7; border-radius:12rpx; background:#fff; font-size:25rpx; line-height:78rpx; }
.consent-row { display:flex; gap:16rpx; margin-top:22rpx; color:#66584e; font-size:23rpx; line-height:1.55; }
.checkbox { display:flex; flex:0 0 34rpx; align-items:center; justify-content:center; width:34rpx; height:34rpx; margin-top:2rpx; border:2rpx solid #b9a695; border-radius:12rpx; }
.checkbox.checked { border-color:#c2602c; background:#c2602c; color:#fff; }
.submit { margin-top:30rpx; }
.submit[disabled] { opacity:.65; }
