.custom-navbar {
  position: relative;
  z-index: 20;
  width: 100%;
  background: #fff;
  box-sizing: border-box;
}

.custom-navbar-main {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.custom-navbar-brand {
  display: flex;
  align-items: center;
  color: #3f3f3f;
  font-size: var(--type-navbar);
  font-weight: 760;
  letter-spacing: 1rpx;
}

.home-page {
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 8rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.me-icon-button {
  position: absolute;
  top: 50%;
  left: 32rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  min-width: 80rpx;
  max-width: 80rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  box-sizing: border-box;
  line-height: 1;
  transform: translateY(-50%);
}

.hamburger-icon {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 42rpx;
  height: 32rpx;
}

.hamburger-icon view {
  width: 100%;
  height: 5rpx;
  border-radius: 999rpx;
  background: #3f3f3f;
}

.conversation {
  flex: 1 1 0;
  height: 0;
  min-height: 0;
  padding: 24rpx 0 28rpx;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100%;
  padding-bottom: 96rpx;
  box-sizing: border-box;
  text-align: center;
}

.hero-logo {
  width: 106rpx;
  height: 106rpx;
  margin-bottom: 42rpx;
}

.hero-title {
  max-width: 620rpx;
  color: #3f3f3f;
  font-size: var(--type-display);
  font-weight: 760;
  line-height: 1.38;
}

.message-row {
  display: flex;
  margin: 28rpx 0 34rpx;
}

.user-row {
  justify-content: flex-end;
}

.user-message {
  max-width: 580rpx;
  padding: 22rpx 26rpx;
  border-radius: 26rpx;
  background: #f4f6f4;
  color: #414141;
  font-size: var(--type-body);
  line-height: 1.6;
}

.assistant-block {
  padding: 10rpx 0 36rpx;
}

.assistant-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
  color: #3f3f3f;
  font-size: var(--type-title);
  font-weight: 760;
}

.assistant-head.danger {
  color: #8a2d26;
}

.assistant-logo {
  width: 44rpx;
  height: 44rpx;
}

.answer-lead {
  margin-bottom: 30rpx;
  color: #3f3f3f;
  font-size: var(--type-body);
  font-weight: 680;
  line-height: 1.7;
}

.answer-section {
  padding: 28rpx 0;
  border-top: 2rpx solid #ececec;
}

.answer-title {
  margin-bottom: 14rpx;
  color: #18b85f;
  font-size: var(--type-body);
  font-weight: 760;
}

.answer-copy,
.answer-item {
  color: #4a4a4a;
  font-size: var(--type-body);
  line-height: 1.72;
}

.answer-item {
  position: relative;
  padding-left: 24rpx;
}

.answer-item::before {
  position: absolute;
  left: 2rpx;
  top: 22rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #18c463;
  content: "";
}

.answer-note {
  margin-top: 12rpx;
  color: #9a9a9a;
  font-size: var(--type-caption);
  line-height: 1.6;
}

.loading-block {
  min-height: 260rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
  padding-left: 58rpx;
}

.loading-dots text {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #18c463;
  opacity: .35;
}

.api-warning {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 0 0 auto;
  margin-bottom: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #f6f7f6;
  color: #727272;
  font-size: var(--type-caption);
}

.api-warning button {
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #18b85f;
  font-size: var(--type-caption);
  line-height: 52rpx;
}

.composer {
  flex: 0 0 auto;
  width: 100%;
  min-height: 274rpx;
  padding: 24rpx 22rpx 18rpx;
  border: 2rpx solid #dcdcdc;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 18rpx 50rpx rgba(0, 0, 0, .05);
  box-sizing: border-box;
}

.composer-input {
  width: 100%;
  height: 170rpx;
  min-height: 170rpx;
  color: #444;
  font-size: var(--type-body);
  line-height: 1.55;
  box-sizing: border-box;
}

.composer-input[disabled] {
  color: #999;
}

.composer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 66rpx;
  margin-top: 8rpx;
}

.composer-bottom text {
  color: #989898;
  font-size: var(--type-caption);
}

.send-button {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 66rpx;
  width: 66rpx;
  min-width: 66rpx;
  max-width: 66rpx;
  height: 66rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #18c463;
  box-sizing: border-box;
}

.send-button image {
  width: 38rpx;
  height: 38rpx;
}

.send-button.disabled {
  background: #d9d9d9;
  color: #fff;
}
