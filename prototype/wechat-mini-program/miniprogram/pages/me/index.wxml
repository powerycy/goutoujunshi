<view class="page-shell me-page">
  <view class="profile-button page-enter" bindtap="syncProfile">
    <image class="profile-avatar" src="{{avatarUrl || '/assets/doghead-logo.png'}}" mode="aspectFill" />
    <view class="profile-copy">
      <view class="profile-name">{{displayName}}</view>
      <view class="profile-status">{{profileHint}}</view>
    </view>
    <text class="chevron">›</text>
  </view>

  <view class="asset-list">
    <view class="menu-row" bindtap="goPricing">
      <text>狗头余额</text>
      <view class="row-side"><text class="balance-count">{{dogheadCount}}</text><text class="chevron">›</text></view>
    </view>
    <view class="menu-row" bindtap="goPricing">
      <text>充值</text>
      <view class="row-side green"><text>1 元起</text><text class="chevron">›</text></view>
    </view>
  </view>

  <view class="more-group">
    <view class="more-trigger" bindtap="toggleMore">
      <text>更多</text>
      <view class="row-side"><text>赠品 · 历史 · 服务</text><text class="chevron {{moreOpen ? 'open' : ''}}">›</text></view>
    </view>
    <view wx:if="{{moreOpen}}" class="more-list">
      <view class="menu-row compact-row">
        <text>赠品</text>
        <text class="row-value">{{giftSummary}}</text>
      </view>
      <view class="menu-row compact-row" bindtap="goHistory">
        <text>历史判断</text>
        <text class="chevron">›</text>
      </view>
      <view class="menu-row compact-row" bindtap="goRecords">
        <text>购买记录</text>
        <text class="chevron">›</text>
      </view>
      <view class="menu-row compact-row" bindtap="suggestProduct">
        <text>产品建议</text>
        <text class="chevron">›</text>
      </view>
      <view class="menu-row compact-row" bindtap="contactSupport">
        <text>反馈与客服</text>
        <text class="chevron">›</text>
      </view>
      <button class="delete-account" bindtap="deleteAccount">删除账号与历史</button>
      <view class="quiet-note">请使用代号描述他人。删除账号会清除可识别的历史内容。</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="danger-note">{{error}}</view>
</view>
