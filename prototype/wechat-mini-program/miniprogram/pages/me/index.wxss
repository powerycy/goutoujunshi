.me-page {
  padding-top: 34rpx;
  overflow: visible;
}

.profile-button {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 16rpx 0 28rpx;
  background: transparent;
  text-align: left;
}

.profile-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f1f4f2;
}

.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.profile-name {
  color: #3f3f3f;
  font-size: var(--type-title);
  font-weight: 700;
  line-height: 1.2;
}

.profile-status {
  margin-top: 8rpx;
  color: #8a8a8a;
  font-size: var(--type-caption);
}

.asset-list,
.utility-list {
  overflow: hidden;
  border-top: 2rpx solid #eeeeee;
}

.utility-list {
  margin-top: 34rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 106rpx;
  border-bottom: 2rpx solid #eeeeee;
  color: #444;
  font-size: var(--type-body);
  font-weight: 500;
}

.balance-row {
  cursor: default;
}

.row-side {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #9a9a9a;
  font-size: var(--type-secondary);
  font-weight: 400;
}

.balance-count {
  color: #3f3f3f;
  font-size: var(--type-body);
  font-weight: 700;
}

.row-side.green {
  color: #18b85f;
}

.chevron {
  color: #b8b8b8;
  font-size: 44rpx;
  line-height: 1;
}

.delete-account {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 82rpx;
  margin: 18rpx 0 0;
  padding: 0;
  background: transparent;
  color: #9b4742;
  font-size: var(--type-caption);
  line-height: 82rpx;
  text-align: center;
  box-sizing: border-box;
}

.me-page .danger-note {
  padding: 20rpx;
  border: 0;
  border-radius: 16rpx;
  background: #f6f7f6;
  color: #727272;
  font-size: var(--type-caption);
}
